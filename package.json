{
  "name": "pulse",
  "version": "1.0.0",
  "description": "Self-hosted website health monitoring.",
  "type": "commonjs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"vite src/client\"",
    "build": "tsc && vite build && node scripts/copy-spa.mjs",
    "start": "node dist/src/server.js",
    "check:once": "tsx scripts/run-checks.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "express": "^5.1.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "node-cron": "^4.2.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.2",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "prisma": "^6.3.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^3.0.4"
  }
}
